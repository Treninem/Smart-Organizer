  "rules": [
    {
      "id": "preserve-existing-tree",
      "action": "prefer_existing_folder",
      "confidence": 1.0,
      "explanation": "Пользовательская структура имеет приоритет над автоматически предлагаемой."
    },
    {
      "id": "duplicate-by-hash",
      "action": "duplicate_candidate_only_after_sha256_match",
      "confidence": 1.0,
      "explanation": "bot.exe и bot(1).exe можно считать точными копиями только после совпадения SHA-256 внутри одного безопасного проектного контекста."
    },
    {
      "id": "protect-cross-project-files",
      "action": "never_deduplicate_across_project_scopes",
      "confidence": 1.0,
      "explanation": "Одинаковые main.py, config.json, изображения, библиотеки и любые другие файлы в разных проектах считаются независимыми и не попадают в удаляемые дубликаты или карантин."
    },
    {
      "id": "version-order",
      "action": "compare_semver_before_old_version_candidate",
      "confidence": 0.95,
      "explanation": "v1.0.3 старее v3.x одного и того же проекта, но сначала подтвердить идентичность проекта и тип релиза."
    },
    {
      "id": "protect-local-memory",
      "action": "never_replace_data_directory_during_update",
      "confidence": 1.0,
      "explanation": "knowledge.db, projects.json, rules.json, versions.json, history.json и decisions.json являются локальной памятью."
    },
    {
      "id": "background-explicit-routes-first",
      "action": "background_moves_require_existing_explicit_or_mature_route",
      "confidence": 1.0,
      "explanation": "Фоновая сортировка не угадывает: проектный маршрут, ChatGPT/OpenAI-маршрут или маршрут категории должен вести в существующую папку; иначе требуется зрелое локальное обучение."
    },
    {
      "id": "self-correct-own-moves-only",
      "action": "correct_only_applied_journal_moves_when_stricter_route_exists",
      "confidence": 1.0,
      "explanation": "Автоисправление не трогает произвольные пользовательские файлы: оно может исправлять только собственные ранее применённые перемещения Smart Organizer при появлении более точного явного маршрута."
    }
  ]
